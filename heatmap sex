library(dplyr)
library(tidyr)
library(stringr)
library(ComplexHeatmap)
library(circlize)

# ============================================================
# 1. LEITURA E PARSING DOS DADOS
# ============================================================
perb <- read.table("AD_scRank_2025/data/sex/rank_scores/perbscore_all_targets_sex.txt",
                   header = TRUE, sep = "\t")

perb_parsed <- perb %>%
  filter(binding == "agonist") %>%   # ajuste/remova se você decidiu incluir antagonist também
  mutate(
    stage    = str_extract(cell_type, "^(Early|Late)"),
    sex      = str_extract(cell_type, "(Female|Male)"),
    Subclass = str_remove(cell_type, "^(Early|Late)_(Female|Male)_")
  )

# ============================================================
# 2. MAPEAMENTO DOS MACROGRUPOS
# ============================================================
celltype_to_macro <- c(
  "L2_3_IT"      = "Excitatory neurons",
  "L4_IT"        = "Excitatory neurons",
  "L5_IT"        = "Excitatory neurons",
  "L6_IT"        = "Excitatory neurons",
  "L6_IT_Car3"   = "Excitatory neurons",
  "L5_ET"        = "Excitatory neurons",
  "L5_6_NP"      = "Excitatory neurons",
  "L6_CT"        = "Excitatory neurons",
  "L6b"          = "Excitatory neurons",
  "Lamp5"        = "Inhibitory neurons",
  "Lamp5_Lhx6"   = "Inhibitory neurons",
  "Sncg"         = "Inhibitory neurons",
  "Vip"          = "Inhibitory neurons",
  "Sst"          = "Inhibitory neurons",
  "Pvalb"        = "Inhibitory neurons",
  "Chandelier"   = "Inhibitory neurons",
  "Pax6"         = "Inhibitory neurons",
  "Astrocyte"           = "Astrocytes",
  "Oligodendrocyte"     = "Oligodendrocytes",
  "OPC"                 = "OPC",
  "Immune"              = "Microglia",
  "Endothelial"         = "Endothelial",      # mantido separado (ajuste seu)
  "VLMC___Perivascular" = "Endothelial"
)

missing_check <- setdiff(unique(perb_parsed$Subclass), names(celltype_to_macro))
if (length(missing_check) > 0) {
  warning("Subclasses sem mapeamento: ", paste(missing_check, collapse = ", "))
}

perb_parsed <- perb_parsed %>%
  mutate(macro_group = celltype_to_macro[Subclass]) %>%
  filter(!is.na(macro_group))

# ============================================================
# 3. THRESHOLD GLOBAL — TOP 2.5%
# ============================================================
threshold_global <- quantile(perb_parsed$perb_score, 0.975)
perb_top <- perb_parsed %>% filter(perb_score >= threshold_global)

# ============================================================
# 4. CLASSIFICAR GENES (SELETIVIDADE) — por macro_group, não por subtipo
# ============================================================
result <- perb_top %>%
  group_by(target) %>%
  summarise(
    n_macrogroups = n_distinct(macro_group),
    max_score     = max(perb_score),
    .groups = "drop"
  ) %>%
  mutate(selectivity = ifelse(n_macrogroups <= 2, "Seletivo", "Não seletivo"))

# ============================================================
# 5. MATRIZ DE SCORES — Subclass mantido como linha (sem média entre subtipos)
# ============================================================
heatmap_df <- perb_parsed %>%
  filter(target %in% result$target) %>%
  group_by(target, macro_group, Subclass, stage, sex) %>%
  summarise(perb_score = mean(perb_score), .groups = "drop") %>%  # só junta duplicatas exatas, se houver
  mutate(row_name = paste0(Subclass, "_", stage, "_", sex)) %>%
  select(target, row_name, macro_group, perb_score)

heatmap_wide <- heatmap_df %>%
  select(-macro_group) %>%
  pivot_wider(names_from = target, values_from = perb_score, values_fill = 0)

heatmap_mat <- as.matrix(heatmap_wide[, -1])
rownames(heatmap_mat) <- heatmap_wide$row_name
heatmap_mat_log <- log10(heatmap_mat + 1e-20)

row_to_macro <- heatmap_df %>%
  distinct(row_name, macro_group) %>%
  tibble::deframe()

row_order_sorted <- names(sort(row_to_macro))
heatmap_mat_log <- heatmap_mat_log[row_order_sorted, ]

row_macro <- row_to_macro[rownames(heatmap_mat_log)]
row_macro <- factor(row_macro, levels = unique(row_macro))

# ============================================================
# 6. ASTERISCO — passou o threshold
# ============================================================
heatmap_df_bool <- perb_parsed %>%
  filter(target %in% result$target) %>%
  mutate(row_name = paste0(Subclass, "_", stage, "_", sex)) %>%
  group_by(target, row_name) %>%
  summarise(passou_top = any(perb_score >= threshold_global), .groups = "drop") %>%
  pivot_wider(names_from = target, values_from = passou_top, values_fill = FALSE)

bool_mat <- as.matrix(heatmap_df_bool[, -1])
rownames(bool_mat) <- heatmap_df_bool$row_name
bool_mat <- bool_mat[rownames(heatmap_mat_log), colnames(heatmap_mat_log)]

# ============================================================
# 7. ANOTAÇÃO — Stage/Sex nas linhas, nomes limpos, cores customizadas
# ============================================================
stage_annot <- ifelse(grepl("_Early_", rownames(heatmap_mat_log)), "Early", "Late")
sex_annot   <- ifelse(grepl("_Female$", rownames(heatmap_mat_log)), "Female", "Male")

row_annot <- rowAnnotation(
  Stage = stage_annot,
  Sex   = sex_annot,
  col   = list(
    Stage = c("Early" = "#66C2A5", "Late" = "#FC8D62"),
    Sex   = c("Male" = "#8DA0CB", "Female" = "#E78AC3")
  ),
  annotation_legend_param = list(Stage = list(title = "Stage"), Sex = list(title = "Sex")),
  simple_anno_size = unit(4, "mm")
)

row_labels_clean <- sub("_(Early|Late)_(Male|Female)$", "", rownames(heatmap_mat_log))

# ============================================================
# 8. HEATMAP FINAL
# ============================================================
group_sizes <- table(row_meta <- result %>% filter(target %in% colnames(heatmap_mat_log)) %>% pull(selectivity))
pode_clusterizar_col <- all(group_sizes >= 2)

cell_size <- unit(4, "mm")

ht <- Heatmap(
  heatmap_mat_log,
  name                    = "log10(score)",
  width                   = ncol(heatmap_mat_log) * cell_size,
  height                  = nrow(heatmap_mat_log) * cell_size,
  row_labels              = row_labels_clean,
  left_annotation         = row_annot,
  row_split               = row_macro,
  row_title_gp            = gpar(fontsize = 9, fontface = "bold"),
  row_title_rot           = 0,
  row_gap                 = unit(1.5, "mm"),
  cluster_rows            = FALSE,
  cluster_row_slices      = FALSE,
  show_row_names          = TRUE,
  row_names_gp            = gpar(fontsize = 7),
  column_split            = result$selectivity[match(colnames(heatmap_mat_log), result$target)],
  column_title_gp         = gpar(fontsize = 10, fontface = "bold"),
  column_title_side       = "bottom",
  cluster_columns         = pode_clusterizar_col,
  cluster_column_slices   = FALSE,
  show_column_dend        = FALSE,
  show_column_names       = TRUE,
  column_names_gp         = gpar(fontsize = 7),
  cell_fun = function(j, i, x, y, width, height, fill) {
    if (bool_mat[i, j]) {
      grid.text("*", x, y, gp = gpar(fontsize = 8, fontface = "bold", col = "black"))
    }
  }
)

png("heatmap_subtype_macrogroup_final.png", width = 3200, height = 2200, res = 150)
draw(ht, heatmap_legend_side = "right")
dev.off()
