# ============================================================
# TOP 10 GENES POR LINHA (Subtipo+Stage+Sex) — só Excitatory e Inhibitory
# ============================================================
top_n_por_linha <- 10
grupos_a_filtrar <- c("Excitatory neurons", "Inhibitory neurons")

# Para cada linha dentro dos grupos-alvo, pega os top N genes daquela linha específica
top_targets_filtrados <- heatmap_df %>%
  filter(macro_group %in% grupos_a_filtrar) %>%
  group_by(row_name) %>%
  slice_max(order_by = perb_score, n = top_n_por_linha, with_ties = FALSE) %>%
  ungroup() %>%
  pull(target) %>%
  unique()

# Targets dos outros grupos (mantidos sem filtro nenhum)
targets_outros_grupos <- heatmap_df %>%
  filter(!macro_group %in% grupos_a_filtrar) %>%
  pull(target) %>%
  unique()

# União final de colunas a manter
targets_finais <- union(top_targets_filtrados, targets_outros_grupos)
targets_finais <- intersect(targets_finais, colnames(heatmap_mat_log))

# ============================================================
# FILTRAR A MATRIZ E OBJETOS DEPENDENTES
# ============================================================
heatmap_mat_log <- heatmap_mat_log[, targets_finais, drop = FALSE]
bool_mat        <- bool_mat[, targets_finais, drop = FALSE]

column_split_filtrado <- result$selectivity[match(colnames(heatmap_mat_log), result$target)]
